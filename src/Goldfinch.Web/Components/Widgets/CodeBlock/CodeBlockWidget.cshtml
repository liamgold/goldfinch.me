@model Goldfinch.Web.Components.Widgets.CodeBlock.CodeBlockWidgetViewModel

<pre class="js-codeblock"><div class="codeblock-scroll"><code class="language-@Model.CodeClassName">@Model.CodeText</code></div><button class="codeblock-copy-btn" type="button" hidden aria-label="Copy code" data-label-default="Copy code" data-label-copied="Copied"><span class="codeblock-copy-btn__default"><icon name="copy" size="13" /></span><span class="codeblock-copy-btn__copied"><icon name="check" size="13" /></span></button></pre>